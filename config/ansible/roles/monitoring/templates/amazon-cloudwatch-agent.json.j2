{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/auth.log",
            "log_group_name": "{{ cloudwatch_log_group_auth }}",
            "log_stream_name": "{instance_id}/auth.log",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "{{ cloudwatch_log_group_syslog }}",
            "log_stream_name": "{instance_id}/syslog",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "{{ cloudwatch_log_group_nginx_access }}",
            "log_stream_name": "{instance_id}/nginx-access.log",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "{{ cloudwatch_log_group_nginx_error }}",
            "log_stream_name": "{instance_id}/nginx-error.log",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}